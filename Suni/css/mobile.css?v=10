/* Preserve the exported composition while fitting the mobile viewport. */
[hidden] { display: none !important; }
.stage { padding: 0; min-height: 100dvh; }
.device { width: 390px; height: 844px; }
.screen { width: 420px; height: 909px; transform-origin: top left; zoom: var(--screen-scale, .928571); }
.screen--habitos { overflow-y: auto; overflow-x: hidden; }
.screen--login, .screen--perfil, .screen--buddi, .screen--home { overflow-y: auto; overflow-x: hidden; }
.screen--login::after, .screen--perfil::after, .screen--buddi::after, .screen--home::after { content: ''; position: absolute; top: 890px; height: 20px; width: 1px; }
.screen--habitos::after { content: ''; position: absolute; top: 1198px; width: 1px; height: 24px; }
.screen--buddi > .btn--ink { z-index: 2; }
.field__box, .p-input, .goal-input { font-family: Roboto, sans-serif; }
input.field__box { display: block; border: 0; padding: 0 16px; color: var(--c-ink); font-size: 16px; }
input.p-input { text-align: center; cursor: text; }
input.goal-input { padding: 0 12px; font-size: 16px; color: var(--c-ink); z-index: 10000; }
.suni .face, .suni .goal-save, .suni .goal-edit { z-index: 10001; }
.suni[data-state^="done-"] .goal-input,
.suni[data-state^="saved-"] .goal-input { opacity: 1; pointer-events: none; }
.suni[data-state^="saved-"] .face { visibility: hidden; }
.field:focus-within .field__box { background: var(--field-focus); }
.status { position: fixed; bottom: max(8px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); width: min(360px, calc(100% - 24px)); padding: 8px 12px; border-radius: 12px; background: var(--c-bg-warm); color: var(--c-ink); font-size: 13px; box-shadow: var(--sh-card); z-index: 20000; pointer-events: none; }
.status:empty { display: none; }
.local-note { position: absolute; top: 770px; left: 65px; width: 290px; text-align: center; font-size: 14px; color: var(--c-title); }
.screen--registro .local-note { top: 1220px; }
.splash__slogan { left: 93px; top: 321px; }
.navbtn { height: 77px; }
.navbtn img { height: 77px; }
.bluetooth { left: 305px; top: 188px; width: 72px; height: 38px; }
.bluetooth::before { left: 0; top: 0; width: 72px; height: 38px; box-shadow: var(--rim-glass); }
.bluetooth img { left: 8px; top: 4px; }
.bluetooth.is-on img { transform: translateX(27px); }
.btn--sound { background: rgba(78,77,33,.2); color: #744500; }
.btn--sound:hover, .btn--sound:active { background: rgba(78,77,33,.5); }
.btn--sound.is-selected { background: rgba(142,159,163,.5); box-shadow: var(--rim-glass), var(--sh-btn); }
.bar__line { background: rgba(255,252,226,.92); transition: background 80ms linear; }
.bar__line.is-off { background: rgba(255,252,226,.13); }
.volume-status { position: absolute; left: 42px; top: 433px; width: 336px; color: #FFFCE2; font-size: 13px; }
.habits__list { left: 34px; top: 487px; width: 351px; }
.habits__list .row { width: 351px !important; padding: 10px 8px; gap: 16px; justify-content: center; box-shadow: var(--rim-glass); }
.row[data-day="3"] .row__day { font-size: 19px; }
.row__time { padding: 4px; gap: 4px; width: 64px; height: 30px; border-radius: 5px; box-shadow: var(--rim-glass); }
.row__time b { width: 6px; text-align: center; font-size: 20px; }
.time-part { appearance: none; border: 0; padding: 0; margin: 0; width: 21px; height: 30px; background: transparent; color: var(--c-title); font: 400 18px Roboto, sans-serif; cursor: pointer; }
.time-part:focus-visible { outline: 2px solid var(--c-cream); outline-offset: 2px; }
.time-part option { background: #F9DEA6; color: #744500; }
.row__icon { justify-content: center; }
.routine-status { position: absolute; top: 1114px; left: 34px; width: 351px; color: #FFFCE2; font-size: 13px; }
.notification-settings { position: absolute; top: 1160px; left: 34px; width: 351px; min-height: 44px; border: 0; background: var(--glass); color: #FFFCE2; border-radius: 12px; font: 14px Roboto, sans-serif; cursor: pointer; }
.notification-dialog { position: absolute; left: 30px; top: 399px; width: 360px; min-height: 166px; padding: 14px 15px; background: linear-gradient(180deg,#AA8649,#9A6F31 18%); border-radius: 10px; color: #DDD69D; z-index: 11000; box-shadow: var(--sh-card); }
.notification-dialog p { margin: 0; font: 300 18px/21px Roboto, sans-serif; text-align: center; }
.notification-dialog .notification-question { display: flex; align-items: center; gap: 11px; margin: 16px 0; white-space: nowrap; font-weight: 400; }
.notification-question img { width: 22px; height: 25px; }
.notification-dialog .btn { position: relative; width: 330px; height: 39px; padding: 0; font-size: 18px; color: #DDD69D; }
.screen--habitos[data-notification-state="prompt"] .habits__list,
.screen--habitos[data-notification-state="accepted"] .habits__list { top: 526px; }
.screen--habitos[data-notification-state="prompt"] [data-action="habitos:save"],
.screen--habitos[data-notification-state="accepted"] [data-action="habitos:save"] { top: 1093px !important; }
.screen--habitos[data-notification-state] .routine-status { top: 1150px; }
.screen--habitos[data-notification-state] .notification-settings { top: 1198px; }
.screen--habitos::after { top: 1260px; }
.perfil__save .pd-v4 { left: 1px; top: 0; }
.screen--perfil:not(.is-editing) .perfil__save { display: none; }
.screen--perfil .p-input:read-only { cursor: default; }
.home__greeting { max-width: 365px; overflow: hidden; text-overflow: ellipsis; }
.btn.is-saved { background: transparent; box-shadow: none; color: #635625; font-size: 10px; }
.btn.is-saved::before { content: ''; position: absolute; width: 107px; height: 23px; border-radius: 10px; background: #D3C068; z-index: -1; }
@media (max-width: 430px) {
  body { background: var(--c-bg-warm); }
  .stage { padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom); align-items: flex-start; }
  .device { width: 100%; height: calc(100dvh - env(safe-area-inset-top) - env(safe-area-inset-bottom)); box-shadow: none; }
}

/* 2026-10-22: marco móvil para vista en escritorio; interior Figma 420×912 */
@media (min-width: 431px) {
  body { background: radial-gradient(circle at 50% 15%, #4b4a43 0, #252521 44%, #171819 100%); }
  .stage { min-height: 100dvh; padding: 35px 18px; }
  .device {
    position: relative; border-radius: 38px;
    outline: 9px solid #17191d;
    box-shadow: 0 0 0 11px #41454a, 0 0 0 12px #737980,
                0 32px 90px rgba(0,0,0,.65);
    isolation: isolate;
  }
  .device::after {
    content: ''; position: absolute; z-index: 15000;
    left: 50%; top: 6px; transform: translateX(-50%);
    width: 95px; height: 19px; border-radius: 0 0 15px 15px;
    background: #17191d; pointer-events: none;
  }
}
/* En móvil no simular un segundo teléfono dentro del teléfono. */
@media (max-width: 430px) { .device { border-radius: 0; outline: 0; } }
/* Ajustes de color y contraste contra los rellenos actualizados de Figma */
:root { --grad-sun: linear-gradient(180deg,#FAE8C4 0%,#FEBF6D 30.165%,#E2BB6E 100%); }
.screen--buddi { background: linear-gradient(180deg,#FAE8C4 0%,#FEBF6D 9.03%,#E2BB6E 100%); }
.screen--habitos .notification-dialog { background: linear-gradient(180deg,#DDD69D 0.96%,#9A6F31 39.27%); color:#323100; }
.screen--habitos .notification-dialog .btn { color:#323100; background:rgba(255,251,226,.32); }
/* La ventana es modal solo cuando el usuario guarda por primera vez. */
.screen--habitos .notification-dialog:not([hidden]) { z-index: 18000; }

/* Corrección: las entradas editables son transparentes y se apoyan sobre
   los tres campos dibujados por Figma; no se crean barras superpuestas. */
.suni .goal-input { background: transparent !important; box-shadow: none !important;
  border: 0; border-radius: 0; font-size: 13px; font-weight: 500;
  color: #6f5730; padding-left: 23px; padding-right: 6px; }
.suni .goal-input:focus { outline: 2px solid #9a6f31; outline-offset: 0; border-radius: 12px; }
.suni .goal-input::placeholder { color: transparent; }
.suni[data-state^="done-"] .goal-input,
.suni[data-state^="saved-"] .goal-input { display: none !important; }
/* En los sprites guardados se borró solamente el texto de muestra, no las barras. */
.suni .goal-summary { z-index: 100; left: 178px; width: 187px; height: 25px;
  padding: 0 3px; border: 0; border-radius: 0; box-shadow: none;
  background: transparent; color: #6f5730; font: 500 13px/25px Roboto,sans-serif; }
/* La palabra «Editar» ya forma parte del sprite original. */
.suni[data-state^="done-"] .goal-edit,
.suni[data-state^="saved-"] .goal-edit { font-size: 0; width: 48px; height: 24px; }
/* Cuatro nubes espaciadas, de derecha a izquierda, hasta salir por completo.
   Nunca invierten el sentido: al terminar vuelven al lado derecho. */
.screen--habitos { isolation: isolate; }
.screen--habitos .cloud { left: 420px; width: 235px; height: 130px;
  animation-name: suni-cloud-cross; animation-duration: 24s;
  animation-timing-function: linear; animation-iteration-count: infinite;
  animation-direction: normal; animation-fill-mode: both; }
.screen--habitos .cloud--1 { top: 65px; animation-delay: -2s; opacity: .66; }
.screen--habitos .cloud--2 { top: 178px; animation-delay: -8s; opacity: .78; }
.screen--habitos .cloud--3 { top: 110px; animation-delay: -14s; opacity: .65; }
.screen--habitos .cloud--4 { top: 235px; animation-delay: -20s; opacity: .72; }
@keyframes suni-cloud-cross { from { transform: translateX(0); } to { transform: translateX(-655px); } }
@media (prefers-reduced-motion: reduce) {
  .screen--habitos .cloud { animation: none !important; transform: translateX(-220px); }
}
