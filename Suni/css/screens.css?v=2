.perfil__face {
  position: absolute;
  left: 150px;
  top: 175px;
  width: 119px;
  height: 120px;
}

.perfil__name {
  position: absolute;
  left: 175px;
  top: 320px;
  margin: 0;
  height: 29px;
  font: 700 25px/29.296875px "Roboto", sans-serif;
  color: var(--c-p-name);
  white-space: nowrap;
}

.perfil__edit {
  position: absolute;
  left: 187px;
  top: 347px;
  padding: 0;
  border: 0;
  background: none;
  height: 18px;
  font: 500 15px/17.578125px "Roboto", sans-serif;
  color: var(--c-title);
  cursor: pointer;
  transition: opacity 150ms ease, transform 120ms ease;
}
.perfil__edit:hover  { opacity: .75; }
.perfil__edit:active { transform: scale(.94); }

.perfil__label {
  position: absolute;
  height: 23px;
  font: 700 20px/23.4375px "Roboto", sans-serif;
  color: var(--c-p-label);
  white-space: nowrap;
}

.perfil__save {
  position: absolute;
  left: 133px;      /* hotspot sobre la forma Vector 4 (134,778) 152×60 */
  top: 778px;
  width: 174px;
  height: 60px;
  padding: 0;
  border: 0;
  background: none;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.perfil__save span {
  position: absolute;
  left: 42px;       /* texto en (175,808) → relativo al hotspot */
  top: 30px;
  height: 23px;
  font: 600 20px/23.4375px "Roboto", sans-serif;
  color: var(--c-p-save);
  white-space: nowrap;
  transition: transform 150ms var(--ease-out);
}
.perfil__save:hover span  { transform: translateY(-1px); }
.perfil__save:active span { transform: translateY(1px); }

/* ---------- Accesibilidad: movimiento reducido --------------------------- */
@media (prefers-reduced-motion: reduce) {
  * { transition-duration: 1ms !important; animation-duration: 1ms !important; }
}
